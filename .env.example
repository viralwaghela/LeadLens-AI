OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
OPENAI_FAST_MODEL=gpt-5-mini
OPENAI_STORE_RESPONSES=false
APP_URL=http://localhost:8501
# Keep real credentials in a local .env file. Never share or commit it.

# Required before deploying anywhere with real clinic data: a shared
# access password for the whole dashboard. Without this, anyone with the
# URL can see the clinic's data. Set this via your hosting platform's
# secrets manager in production, not a committed .env file.
APP_PASSWORD=

# Optional. Leave blank to use a local SQLite file (fine for local dev,
# but NOT safe if you deploy somewhere with an ephemeral filesystem, e.g.
# Streamlit Community Cloud's free tier — it wipes local files on every
# sleep/reboot/redeploy). Set this to a Postgres connection string from
# Supabase or Neon (both have free tiers) to move the data somewhere that
# survives regardless of what happens to the app container. Existing
# local data is migrated in automatically the first time this connects.
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
#
# If using Supabase, either the direct connection string
# (db.<project-ref>.supabase.co) or the shared pooler hostname
# (aws-0-<region>.pooler.supabase.com) work fine. An earlier version of
# this comment claimed the pooler caused stale reads — that was wrong.
# Investigation on 2026-08-02 initially pointed at the pooler, but the
# real cause was a testing-methodology bug: several ad-hoc diagnostic
# scripts checked state via core.memory without first loading .env, so
# they silently read the local SQLite fallback (frozen from early
# testing) instead of Postgres, and that got mistaken for the real
# database serving stale data. There was no pooler bug. core.memory
# currently targets the direct connection string as a side effect of
# that investigation, not because it's required.
DATABASE_URL=

# Phase 21 live integrations. Leave blank to use safe dry-run mode.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_CALENDAR_ID=
GMAIL_DELEGATED_USER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
